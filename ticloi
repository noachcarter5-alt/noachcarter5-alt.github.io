<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>申请加入</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: system-ui, sans-serif;
        }
        body {
            background-color: #f4f6f8;
            padding: 50px 15px 30px;
        }
        /* 左上角返回按钮 */
        .home-back{
            position:fixed;
            top:12px;
            left:12px;
            z-index:99;
        }
        .home-back a{
            background:#2b4b80;
            color:#fff;
            text-decoration:none;
            padding:6px 12px;
            border-radius:6px;
        }
        .home-back a:hover{
            background:#203864;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            padding: 32px;
            border-radius: 12px;
            box-shadow: 0 2px 12px #00000018;
        }
        h2 {
            text-align: center;
            margin-bottom: 26px;
            color: #222;
        }
        .form-item {
            margin-bottom: 18px;
        }
        label {
            display: block;
            margin-bottom: 6px;
            color: #333;
            font-weight: 500;
        }
        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccd0d8;
            border-radius: 8px;
            font-size: 16px;
        }
        button {
            width: 100%;
            padding: 13px;
            background-color: #2b4b80;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 17px;
            cursor: pointer;
        }
        button:hover {
            background-color: #203864;
        }
        .tip {
            margin-top:20px;
            font-size:14px;
            color:#666;
            text-align:center;
        }
        .auto-date-info{
            margin-top:14px;
            padding:12px;
            background:#eef4fc;
            border-radius:8px;
            text-align:center;
            color:#2b4b80;
        }
        /* 弹窗样式 */
        .modal-wrap{
            display:none;
            position:fixed;
            top:0;
            left:0;
            width:100%;
            height:100%;
            background:rgba(0,0,0,0.5);
            align-items:center;
            justify-content:center;
            padding:20px;
            z-index:100;
        }
        .modal{
            width:100%;
            max-width:440px;
            background:white;
            border-radius:10px;
            padding:24px;
        }
        .modal.show{
            display:flex;
        }
        .modal-buttons{
            margin-top:20px;
            display:flex;
            gap:12px;
        }
        .modal-buttons button{
            flex:1;
        }
        .btn-cancel{
            background:#888 !important;
        }
    </style>
</head>
<body>
    <!-- 左上角返回主页 -->
    <div class="home-back">
        <a href="https://noachcarter5-alt.github.io">← 返回</a>
    </div>

    <div class="container">
        <h2> TIC申请加入</h2>
        <div class="form-item">
            <label>名字</label>
            <input type="text" id="name" placeholder="请填写名字">
        </div>
        <div class="form-item">
            <label>联系邮箱（选填）</label>
            <input type="email" id="email" placeholder="可不填写">
        </div>
        <div class="auto-date-info">
            ⏱ 预计审核通过日期：<span id="expectDate"></span>
        </div>
        <button id="nextBtn">下一步</button>
        <div class="tip">提交后，申请记录将会保存直到审核结束后删除，等待审核</div>
    </div>

    <!-- 弹窗：中学名称验证 -->
    <div class="modal-wrap" id="modal">
        <div class="modal">
            <h3>验证填写</h3>
            <div class="form-item" style="margin-top:16px;">
                <label>就读学校</label>
                <input type="text" id="schoolName" placeholder="填写中学名称">
            </div>
            <div class="modal-buttons">
                <button class="btn-cancel" id="cancelBtn">取消</button>
                <button id="confirmBtn">确认，前往提交</button>
            </div>
        </div>
    </div>

<script>
    const USERNAME = "noachcarter5-alt";
    const REPO = "noachcarter5-alt.github.io";
    const MAIN_PAGE = "https://noachcarter5-alt.github.io";

    // 自动算出两天后的日期
    function getTwoDaysLater(){
        let d = new Date();
        d.setDate(d.getDate() + 2);
        let y = d.getFullYear();
        let m = String(d.getMonth()+1).padStart(2,'0');
        let day = String(d.getDate()).padStart(2,'0');
        return `${y}-${m}-${day}`;
    }
    document.getElementById("expectDate").innerText = getTwoDaysLater();

    const nextBtn = document.getElementById("nextBtn");
    const modal = document.getElementById("modal");
    const cancelBtn = document.getElementById("cancelBtn");
    const confirmBtn = document.getElementById("confirmBtn");

    nextBtn.onclick = function(){
        const nameVal = document.getElementById("name").value.trim();
        if(!nameVal){
            alert("名字不能是空白！");
            return;
        }
        modal.classList.add("show");
    }

    cancelBtn.onclick = function(){
        modal.classList.remove("show");
    }

    confirmBtn.onclick = function(){
        const schoolVal = document.getElementById("schoolName").value.trim();
        if(!schoolVal){
            alert("学校名称必须填写！");
            return;
        }
        const nameVal = document.getElementById("name").value.trim();
        const emailVal = document.getElementById("email").value.trim();
        const expectDay = getTwoDaysLater();

        const issueTitle = `新申请 - ${nameVal}`;
        const issueBody = `名字：${nameVal}\n邮箱：${emailVal || '未填写'}\n中学：${schoolVal}\n预计审核日期：${expectDay}\n自我介绍（在这里补充你的申请理由）：`;

        const url = `https://github.com/${USERNAME}/${REPO}/issues/new?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}`;
        // 新开标签页打开github issue提交
        window.open(url,"_blank");
        // 3秒后本页面自动跳回主站
        setTimeout(()=>{
            window.location.href = MAIN_PAGE;
        },3000);
    }
</script>
</body>
</html>